# Database
# Use port 5433 for local Docker Compose (5432 conflicts with local PostgreSQL)
DATABASE_URL=postgresql+asyncpg://kaihle:kaihle@localhost:5433/kaihle
REDIS_URL=redis://localhost:6379/0

# Auth
JWT_SECRET_KEY=changeme-replace-with-64-char-hex-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Email
RESEND_API_KEY=re_xxxxxxxxxxxx
FROM_EMAIL=no-reply@kaihle.ai

# Role app URLs — used in transactional emails (credentials, password reset).
# In production these must point to each app's public URL; wrong values produce broken links in emails.
TEACHER_APP_URL=http://localhost:3001
STUDENT_APP_URL=http://localhost:3002
PARENT_APP_URL=http://localhost:3003
SCHOOL_ADMIN_APP_URL=http://localhost:3004
KAIHLE_ADMIN_APP_URL=http://localhost:3005

# LLM Providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
YOUTUBE_DATA_API_KEY=

# LLM Provider Routing (all tasks default to hosted providers)
# To route a task to your own LLM server, set both _MODEL and _API_BASE:
#   LLM_LESSON_PLAN_MODEL=openai/your-model-name
#   LLM_LESSON_PLAN_API_BASE=http://your-llm-server:8000
LLM_GAP_CLASSIFICATION_MODEL=gemini/gemini-2.5-flash
LLM_GAP_CLASSIFICATION_API_BASE=
LLM_STUDY_PLAN_MODEL=gpt-4.1-mini
LLM_STUDY_PLAN_API_BASE=
LLM_LESSON_PLAN_MODEL=gpt-4.1
LLM_LESSON_PLAN_API_BASE=
LLM_EMBEDDINGS_MODEL=openrouter/openai/text-embedding-3-small
LLM_EMBEDDINGS_DIMENSIONS=768
LLM_EMBEDDINGS_API_BASE=

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=kaihle-assets
AWS_REGION=ap-southeast-1

# App
ENVIRONMENT=development
LOG_LEVEL=INFO

# CORS — add production frontend URLs here (comma-separated)
# Localhost origins are included by default in development.
# Example: CORS_ORIGINS_RAW=https://teacher.kaihle.com,https://student.kaihle.com,https://parent.kaihle.com,https://admin.kaihle.com,https://internal.kaihle.com
CORS_ORIGINS_RAW=

# Platform Stats (Kaihle Admin dashboard)
PLATFORM_LLM_PROVIDER=openai
PLATFORM_RUNPOD_STATUS=blocked
PLATFORM_TRIAL_DAYS=14
PLATFORM_TRIAL_STUDENTS_LIMIT=30
PLATFORM_RATE_LIMIT_REQUESTS_PER_MINUTE=100
PLATFORM_RATE_LIMIT_CONCURRENT_USERS=50
