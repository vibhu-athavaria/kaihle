# Database
# Use port 5433 for local Docker Compose (5432 conflicts with local PostgreSQL)
DATABASE_URL=postgresql+asyncpg://kaihle:kaihle@localhost:5433/kaihle
REDIS_URL=redis://localhost:6379/0

# Auth
JWT_SECRET_KEY=changeme-replace-with-64-char-hex-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Email
RESEND_API_KEY=re_xxxxxxxxxxxx
FROM_EMAIL=no-reply@kaihle.ai

# LLM Providers
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
YOUTUBE_DATA_API_KEY=

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=kaihle-assets
AWS_REGION=ap-southeast-1

# App
ENVIRONMENT=development
LOG_LEVEL=INFO
