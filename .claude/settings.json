{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(pytest *)",
      "Bash(python *)",
      "Bash(uv *)",
      "Bash(uvicorn *)",
      "Bash(alembic *)",
      "Bash(ruff *)",
      "Bash(mypy *)",
      "Bash(pnpm *)",
      "Bash(npm *)",
      "Bash(node *)",
      "Bash(docker *)",
      "Bash(docker compose *)",
      "Bash(cat *)",
      "Bash(ls *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(touch *)",
      "Bash(echo *)",
      "Bash(which *)",
      "Bash(pwd)",
      "Bash(cd *)",
      "Bash(export *)",
      "Bash(env)",
      "Bash(curl *)",
      "Bash(jq *)"
    ],
    "deny": [
      "Bash(rm *)",
      "Bash(rmdir *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(git clean -fd *)",
      "Bash(docker system prune *)",
      "Bash(docker volume rm *)",
      "Bash(docker rm *)",
      "Bash(docker rmi *)",
      "Bash(alembic downgrade *)",
      "Bash(DROP *)",
      "Bash(DELETE *)",
      "Bash(truncate *)"
    ]
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true
  },
  "env": {
    "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "28000"
  }
}
