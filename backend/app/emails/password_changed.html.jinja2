{% extends "base.html.jinja2" %}
{% block content %}

<p style="margin:0 0 8px;font-size:15px;font-weight:600;color:#374151;">Hi {{ first_name }} 👋</p>
<p style="margin:0 0 20px;font-size:14px;color:#6b7280;line-height:1.6;">
  Your password for Kaihle has been updated by a school administrator at {{ school_name }}.
  Use your existing email address and your new password to log in.
</p>

<!-- Info banner -->
<table width="100%" cellpadding="0" cellspacing="0" role="presentation"
       style="background:#f0fdf4;border:1px solid #bbf7d0;border-radius:8px;margin-bottom:24px;">
  <tr>
    <td style="padding:12px 16px;">
      <table cellpadding="0" cellspacing="0" role="presentation">
        <tr>
          <td style="font-size:16px;line-height:1;vertical-align:top;padding-right:10px;">🔐</td>
          <td style="font-size:13px;color:#166534;line-height:1.5;">
            If you did not request this change, please contact your school administrator immediately.
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>

<!-- CTA Button -->
<table width="100%" cellpadding="0" cellspacing="0" role="presentation" style="margin-bottom:24px;">
  <tr>
    <td align="center">
      <a href="{{ login_url }}"
         style="display:inline-block;background:#1a5c38;color:#ffffff;font-size:14px;font-weight:600;
                padding:12px 32px;border-radius:8px;text-decoration:none;letter-spacing:-0.2px;">
        Log in to Kaihle →
      </a>
    </td>
  </tr>
</table>

<p style="margin:0;font-size:12px;color:#9ca3af;line-height:1.5;text-align:center;">
  This notification was sent because your password was changed by {{ school_name }}.
</p>

{% endblock %}
