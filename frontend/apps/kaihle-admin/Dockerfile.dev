FROM node:20-alpine

WORKDIR /app

RUN npm install -g pnpm

# Store lives outside the bind-mounted volume — avoids VirtioFS hard-link failures
ENV PNPM_HOME=/root/.pnpm-store

EXPOSE 3005

CMD ["sh", "-c", "rm -rf /app/apps/kaihle-admin/node_modules/.vite && pnpm install --config.confirmModulesPurge=false && pnpm dev:kaihle-admin"]
