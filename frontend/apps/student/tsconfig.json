{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["vite/client"],
    "noEmit": true
  },
  "include": ["src"],
  "exclude": [
    "src/tests",
    "src/hooks/__tests__",
    "src/pages/__tests__",
    "src/pages/**/__tests__",
    "src/components/__tests__"
  ]
}
