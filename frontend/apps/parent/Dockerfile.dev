# ============================================================================
# LOCAL DEVELOPMENT ONLY
# 
# This Dockerfile expects node_modules to be mounted from the host.
# Run `pnpm install` in the frontend directory on your host machine first.
# 
# Usage:
#   cd frontend && pnpm install
#   docker compose up frontend-parent
# ============================================================================
FROM node:20-alpine

WORKDIR /app

# Install pnpm globally
RUN npm install -g pnpm

# NOTE: No RUN pnpm install here!
# Dependencies are expected to be mounted from host via volume

EXPOSE 3003

# Run the dev server directly (no install step)
CMD ["pnpm", "dev:parent"]
